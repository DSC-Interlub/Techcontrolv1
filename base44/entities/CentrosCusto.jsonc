{
  "name": "CentrosCusto",
  "type": "object",
  "properties": {
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo do centro de custo (ex: 100101)"
    },
    "nome": {
      "type": "string",
      "description": "Nome do centro de custo"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se o centro de custo est\u00e1 ativo para sele\u00e7\u00e3o"
    }
  },
  "required": [
