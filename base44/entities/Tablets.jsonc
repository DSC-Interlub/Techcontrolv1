{
  "name": "Tablets",
  "type": "object",
  "properties": {
    "data_aquisicao": {
      "type": "string",
      "format": "date",
      "description": "Data de aquisi\u00e7\u00e3o do equipamento"
    },
    "tempo_uso": {
      "type": "string",
      "description": "Tempo de uso do equipamento"
    },
    "marca": {
      "type": "string",
      "description": "Marca do equipamento"
    },
    "nota_fiscal": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "valor": {
      "type": "number",
      "description": "Valor de aquisi\u00e7\u00e3o em reais"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo do equipamento"
    },
    "processador": {
      "type": "string",
      "description": "Processador do equipamento"
    },
    "etiqueta_interna": {
      "type": "string",
      "description": "Etiqueta interna de controle"
    },
    "service_tag": {
      "type": "string",
      "description": "Service Tag ou Serial Number"
    },
    "usuario_atual": {
      "type": "string",
      "description": "Usu\u00e1rio que est\u00e1 usando o equipamento atualmente"
    },
    "colaborador_id": {
      "type": "string",
      "description": "ID \u00fanico do colaborador atual"
    },
    "usuario_desde": {
      "type": "string",
      "format": "date",
      "description": "Data desde quando o usu\u00e1rio atual possui o equipamento"
    },
    "usuarios_anteriores": {
      "type": "array",
      "description": "Lista de usu\u00e1rios anteriores",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "colaborador_id": {
            "type": "string"
          },
          "area": {
            "type": "string"
          },
          "data_inicio": {
            "type": "string",
            "format": "date"
          },
          "data_fim": {
            "type": "string",
            "format": "date"
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    },
    "historico_formatacoes": {
      "type": "array",
      "description": "Hist\u00f3rico de formata\u00e7\u00f5es",
      "items": {
        "type": "object",
        "properties": {
          "data_formatacao": {
            "type": "string",
            "format": "date"
          },
          "observacoes": {
            "type": "string"
          }
        }
      }
    },
    "uf": {
      "type": "string",
      "description": "Estado (UF)"
    },
    "office": {
      "type": "string",
      "description": "Possui Office instalado"
    },
    "antivirus": {
      "type": "string",
      "enum": [
        "Sim",
        "N\u00e3o",
        "N\u00e3o se aplica"
      ],
      "default": "N\u00e3o",
      "description": "Possui antiv\u00edrus instalado"
    },
    "status": {
      "type": "string",
      "enum": [
        "Dispon\u00edvel",
        "Em uso",
        "Reservado",
        "Manuten\u00e7\u00e3o",
        "Formata\u00e7\u00e3o",
        "Danificado"
      ],
      "default": "Dispon\u00edvel",
      "description": "Status do equipamento"
    },
    "condicao": {
      "type": "string",
      "enum": [
        "R\u00e1pido",
        "Normal",
        "Lento",
        "Com Problema"
      ],
      "description": "Condi\u00e7\u00e3o do equipamento"
    },
    "data_formatacao": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima formata\u00e7\u00e3o"
    },
    "disponivel_para_reserva": {
      "type": "boolean",
      "default": false,
      "description": "Indica se o tablet est\u00e1 dispon\u00edvel para reserva"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    }
  },
  "required": []
}