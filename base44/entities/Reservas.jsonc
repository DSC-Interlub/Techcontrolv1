{
  "name": "Reservas",
  "type": "object",
  "properties": {
    "equipamento_id": {
      "type": "string",
      "description": "ID do equipamento reservado"
    },
    "equipamento_tipo": {
      "type": "string",
      "description": "Tipo do equipamento (Notebooks_Externos, PCs_Internos)"
    },
    "equipamento_nome": {
      "type": "string",
      "description": "Nome/modelo do equipamento para exibi\u00e7\u00e3o"
    },
    "solicitante_nome": {
      "type": "string",
      "description": "Nome do solicitante"
    },
    "solicitante_email": {
      "type": "string",
      "description": "Email do solicitante"
    },
    "solicitante_area": {
      "type": "string",
      "description": "\u00c1rea do solicitante"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio da reserva"
    },
    "hora_inicio": {
      "type": "string",
      "description": "Hora de in\u00edcio (formato HH:mm)"
    },
    "data_fim": {
      "type": "string",
      "format": "date",
      "description": "Data de fim da reserva"
    },
    "hora_fim": {
      "type": "string",
      "description": "Hora de fim (formato HH:mm)"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo da reserva"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Confirmada",
        "Em Andamento",
        "Conclu\u00edda",
        "Cancelada"
      ],
      "default": "Pendente",
      "description": "Status da reserva"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": []
}