{
  "name": "Chamados",
  "type": "object",
  "properties": {
    "numero_chamado": {
      "type": "string",
      "description": "N\u00famero do chamado (gerado automaticamente)"
    },
    "tipo_solicitacao": {
      "type": "string",
      "enum": [
        "Sistema",
        "Impressora",
        "Equipamento",
        "Melhorias",
        "Desenvolvimento",
        "Servidor",
        "Outros"
      ],
      "description": "Tipo de solicita\u00e7\u00e3o"
    },
    "titulo_chamado": {
      "type": "string",
      "description": "T\u00edtulo resumido do chamado"
    },
    "sistema_tipo": {
      "type": "string",
      "enum": [
        "WMS",
        "Portal de Vendas",
        "SAP"
      ],
      "description": "Tipo de sistema"
    },
    "sistema_subtipo": {
      "type": "string",
      "enum": [
        "Problema no Sistema",
        "Nova Implementa\u00e7\u00e3o no Sistema"
      ],
      "description": "Subtipo do sistema"
    },
    "impressora_subtipo": {
      "type": "string",
      "enum": [
        "Troca de Cartucho ou Toner",
        "Problema na Impressora"
      ],
      "description": "Subtipo de impressora"
    },
    "equipamento_subtipo": {
      "type": "string",
      "enum": [
        "Lentid\u00e3o no Computador",
        "Problema no Monitor, Mouse ou Teclado",
        "Problema na M\u00e1quina",
        "Formata\u00e7\u00e3o",
        "Solicitar Troca de Equipamento",
        "Outros"
      ],
      "description": "Subtipo de equipamento"
    },
    "equipamento_selecionado": {
      "type": "string",
      "description": "Equipamento selecionado pelo usu\u00e1rio"
    },
    "equipamento_outros_detalhes": {
      "type": "string",
      "description": "Detalhes quando equipamento_subtipo = Outros"
    },
    "melhorias_detalhes": {
      "type": "string",
      "description": "Detalhes da melhoria solicitada"
    },
    "desenvolvimento_detalhes": {
      "type": "string",
      "description": "Detalhes do desenvolvimento solicitado"
    },
    "servidor_subtipo": {
      "type": "string",
      "enum": [
        "Rede",
        "Internet"
      ],
      "description": "Subtipo de servidor"
    },
    "solicitante_nome": {
      "type": "string",
      "description": "Nome do solicitante"
    },
    "solicitante_email": {
      "type": "string",
      "description": "Email do solicitante"
    },
    "solicitante_area": {
      "type": "string",
      "description": "\u00c1rea do solicitante"
    },
    "solicitante_telefone": {
      "type": "string",
      "description": "Telefone do solicitante"
    },
    "equipamento_atual": {
      "type": "string",
      "description": "Equipamento atual (se aplic\u00e1vel)"
    },
    "equipamentos_usuario": {
      "type": "array",
      "description": "Lista de equipamentos do usu\u00e1rio",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "marca": {
            "type": "string"
          },
          "modelo": {
            "type": "string"
          },
          "etiqueta": {
            "type": "string"
          }
        }
      }
    },
    "descricao_problema": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do problema ou solicita\u00e7\u00e3o"
    },
    "anexos": {
      "type": "array",
      "description": "Fotos, imagens e v\u00eddeos anexados ao chamado",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          }
        }
      }
    },
    "urgencia": {
      "type": "string",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Urgente"
      ],
      "default": "M\u00e9dia",
      "description": "N\u00edvel de urg\u00eancia"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em An\u00e1lise",
        "Em Andamento",
        "Aguardando Pe\u00e7a",
        "Aguardando Avalia\u00e7\u00e3o",
        "Resolvido",
        "Cancelado"
      ],
      "default": "Aberto",
      "description": "Status do chamado"
    },
    "data_abertura": {
      "type": "string",
      "format": "date",
      "description": "Data de abertura do chamado"
    },
    "data_inicio_atendimento": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora em que o atendimento foi iniciado"
    },
    "data_conclusao": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora de conclus\u00e3o do chamado"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pelo atendimento"
    },
    "solucao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da solu\u00e7\u00e3o aplicada"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "tempo_resolucao_minutos": {
      "type": "number",
      "description": "Tempo total de resolu\u00e7\u00e3o em minutos (corrido)"
    },
    "tempo_util_minutos": {
      "type": "number",
      "description": "Tempo de resolu\u00e7\u00e3o em minutos \u00fateis (seg-sex, 07:42-17:30)"
    },
    "tempo_total_minutos": {
      "type": "number",
      "description": "Tempo corrido total em minutos (para refer\u00eancia)"
    },
    "tipo_resolucao": {
      "type": "string",
      "enum": [
        "Interno",
        "Terceiro"
      ],
      "description": "Tipo de resolu\u00e7\u00e3o do chamado"
    },
    "terceiro_envolvido": {
      "type": "boolean",
      "default": false,
      "description": "Indica se h\u00e1 empresa terceira envolvida"
    },
    "terceiro_empresa": {
      "type": "string",
      "description": "Nome da empresa terceira"
    },
    "terceiro_numero_chamado": {
      "type": "string",
      "description": "N\u00famero do chamado na empresa terceira"
    },
    "terceiro_data_abertura": {
      "type": "string",
      "format": "date-time",
      "description": "Data de abertura do chamado na empresa terceira"
    },
    "terceiro_data_resolucao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de resolu\u00e7\u00e3o pela empresa terceira"
    },
    "projeto_horas_contratadas": {
      "type": "number",
      "description": "Horas acordadas com a empresa terceira"
    },
    "projeto_horas_realizadas": {
      "type": "number",
      "description": "Horas efetivamente realizadas"
    },
    "projeto_valor_hora": {
      "type": "number",
      "description": "Valor por hora em reais"
    },
    "projeto_envolvidos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nomes dos envolvidos no projeto"
    },
    "projeto_marcos": {
      "type": "array",
      "description": "Marcos do projeto",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Pendente",
              "Conclu\u00eddo"
            ]
          }
        }
      }
    },
    "projeto_aprovacoes": {
      "type": "array",
      "description": "Anexos de aprova\u00e7\u00e3o (prints/documentos)",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          }
        }
      }
    },
    "avaliacao_tempo_resolucao": {
      "type": "number",
      "description": "Avalia\u00e7\u00e3o do tempo de resolu\u00e7\u00e3o (1-5)"
    },
    "avaliacao_qualidade_atendimento": {
      "type": "number",
      "description": "Avalia\u00e7\u00e3o da qualidade do atendimento (1-5)"
    },
    "avaliacao_qualidade_solucao": {
      "type": "number",
      "description": "Avalia\u00e7\u00e3o da qualidade da solu\u00e7\u00e3o (1-5)"
    },
    "avaliacao_comunicacao": {
      "type": "number",
      "description": "Avalia\u00e7\u00e3o da comunica\u00e7\u00e3o (1-5)"
    },
    "avaliacao_nota_geral": {
      "type": "number",
      "description": "Nota geral (1-5)"
    },
    "avaliacao_comentario": {
      "type": "string",
      "description": "Coment\u00e1rio da avalia\u00e7\u00e3o"
    },
    "avaliacao_data": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora da avalia\u00e7\u00e3o"
    },
    "historico": {
      "type": "array",
      "description": "Hist\u00f3rico de altera\u00e7\u00f5es do chamado",
      "items": {
        "type": "object",
        "properties": {
          "data_hora": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "status",
              "observacao",
              "solucao",
              "responsavel",
              "inicio_atendimento",
              "conclusao",
              "avaliacao"
            ]
          },
          "descricao": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          }
        }
      }
    },
    "email_abertura_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Controle: email de abertura j\u00e1 foi enviado"
    },
    "email_inicio_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Controle: email de in\u00edcio de atendimento j\u00e1 foi enviado"
    },
    "email_conclusao_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Controle: email de conclus\u00e3o j\u00e1 foi enviado"
    },
    "ultimo_email_admin_chat": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp do \u00faltimo email enviado ao admin no chat (rate limiting)"
    },
    "ultimo_lembrete_enviado": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp do \u00faltimo lembrete de avalia\u00e7\u00e3o enviado (anti-spam)"
    }
  },
  "required": []
}