{
  "name": "RequisicaoCompras",
  "type": "object",
  "properties": {
    "numero_requisicao": {
      "type": "string",
      "description": "N\u00famero da requisi\u00e7\u00e3o (gerado automaticamente)"
    },
    "colaborador_id": {
      "type": "string",
      "description": "ID do colaborador solicitante"
    },
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador solicitante"
    },
    "colaborador_email": {
      "type": "string",
      "description": "E-mail do colaborador solicitante"
    },
    "colaborador_area": {
      "type": "string",
      "description": "\u00c1rea do colaborador solicitante"
    },
    "aprovador_id": {
      "type": "string",
      "description": "ID do colaborador aprovador (respons\u00e1vel)"
    },
    "aprovador_nome": {
      "type": "string",
      "description": "Nome do aprovador respons\u00e1vel"
    },
    "aprovador_email": {
      "type": "string",
      "description": "E-mail do aprovador respons\u00e1vel"
    },
    "item": {
      "type": "string",
      "description": "Item / produto a ser comprado"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade desejada"
    },
    "centro_custo_codigo": {
      "type": "string",
      "description": "C\u00f3digo do centro de custo onde a compra ser\u00e1 alocada"
    },
    "centro_custo_nome": {
      "type": "string",
      "description": "Nome do centro de custo selecionado"
    },
    "valor_unitario_minimo": {
      "type": "number",
      "description": "Valor unit\u00e1rio m\u00ednimo estimado (R$)"
    },
    "valor_unitario_maximo": {
      "type": "number",
      "description": "Valor unit\u00e1rio m\u00e1ximo estimado (R$)"
    },
    "valor_minimo": {
      "type": "number",
      "description": "Valor total m\u00ednimo estimado (R$)"
    },
    "valor_maximo": {
      "type": "number",
      "description": "Valor total m\u00e1ximo estimado (R$)"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa para a compra"
    },
    "urgencia": {
      "type": "string",
      "enum": [
        "Baixa",
        "M\u00e9dia",
        "Alta",
        "Urgente"
      ],
      "default": "M\u00e9dia",
      "description": "N\u00edvel de urg\u00eancia"
    },
    "fornecedor_sugerido": {
      "type": "string",
      "description": "Fornecedor sugerido (opcional)"
    },
    "anexos": {
      "type": "array",
      "description": "Arquivos anexados",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "file_type": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "Aguardando Aprovador",
        "Aguardando Diretor",
        "Aprovada",
        "Reprovada pelo Aprovador",
        "Reprovada pelo Diretor"
      ],
      "default": "Aguardando Aprovador",
      "description": "Status da requisi\u00e7\u00e3o"
    },
    "token_aprovacao": {
      "type": "string",
      "description": "Token \u00fanico para o diretor aprovar/reprovar via e-mail"
    },
    "aprovador_comentario": {
      "type": "string",
      "description": "Coment\u00e1rio do aprovador ao aprovar/reprovar"
    },
    "aprovador_data": {
      "type": "string",
      "format": "date-time",
      "description": "Data da a\u00e7\u00e3o do aprovador"
    },
    "diretor_comentario": {
      "type": "string",
      "description": "Coment\u00e1rio do diretor ao aprovar/reprovar"
    },
    "diretor_data": {
      "type": "string",
      "format": "date-time",
      "description": "Data da a\u00e7\u00e3o do diretor"
    },
    "historico": {
      "type": "array",
      "description": "Hist\u00f3rico de a\u00e7\u00f5es da requisi\u00e7\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "data_hora": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "item",
    "quantidade",
    "justificativa"
  ]
}