{
  "name": "Comunicados_Artes",
  "type": "object",
  "properties": {
    "tipo_comunicado": {
      "type": "string",
      "enum": [
        "aniversario_colaborador",
        "aniversario_conjuge",
        "aniversario_filho_1ano",
        "tempo_empresa_1ano",
        "tempo_empresa_5anos",
        "tempo_empresa_10anos",
        "boas_vindas",
        "despedida"
      ],
      "description": "Tipo do comunicado"
    },
    "titulo": {
      "type": "string",
      "description": "Nome interno da arte (ex: Arte Anivers\u00e1rio Jo\u00e3o Silva 2026)"
    },
    "colaborador_id": {
      "type": "string",
      "description": "ID do colaborador ao qual esta arte se refere (vazio = arte gen\u00e9rica para boas_vindas/despedida)"
    },
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador (preenchido automaticamente ao selecionar)"
    },
    "imagem_url": {
      "type": "string",
      "description": "URL da imagem/arte enviada"
    },
    "ano_referencia": {
      "type": "number",
      "description": "Ano para o qual esta arte foi criada (preenchido automaticamente)"
    },
    "status_envio": {
      "type": "string",
      "enum": [
        "pendente",
        "enviado",
        "erro"
      ],
      "default": "pendente",
      "description": "Status do envio (gerenciado pela automa\u00e7\u00e3o)"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a automa\u00e7\u00e3o enviou este comunicado"
    },
    "criado_por": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que cadastrou a arte (preenchido automaticamente)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    }
  },
  "required": [
    "tipo_comunicado",
    "titulo"
  ]
}