{
  "name": "Comunicados_Artes",
  "type": "object",
  "properties": {
    "colaborador_id": {
      "type": "string",
      "description": "ID do colaborador ao qual esta demanda se refere"
    },
    "colaborador_nome": {
      "type": "string",
      "description": "Nome do colaborador (preenchido automaticamente)"
    },
    "tipo_comunicado": {
      "type": "string",
      "enum": [
        "aniversario_colaborador",
        "aniversario_conjuge",
        "aniversario_filho_1ano",
        "tempo_empresa",
        "despedida"
      ],
      "description": "Tipo do comunicado"
    },
    "data_evento": {
      "type": "string",
      "format": "date",
      "description": "Data em que o e-mail deve ser enviado"
    },
    "descricao_evento": {
      "type": "string",
      "description": "Texto descritivo gerado automaticamente. Ex: Jo\u00e3o Silva \u2014 Anivers\u00e1rio em 15/05/2026"
    },
    "imagem_url": {
      "type": "string",
      "description": "URL da arte ap\u00f3s upload (vazio = sem arte ainda)"
    },
    "status_arte": {
      "type": "string",
      "enum": [
        "sem_arte",
        "arte_carregada",
        "enviado",
        "erro_envio"
      ],
      "default": "sem_arte",
      "description": "Status da arte: sem_arte, arte_carregada, enviado ou erro_envio"
    },
    "criado_por": {
      "type": "string",
      "description": "Preenchido automaticamente com nome do usu\u00e1rio/sistema que criou a demanda"
    },
    "observacoes": {
      "type": "string",
      "description": "Campo livre opcional"
    },
    "ano_referencia": {
      "type": "number",
      "description": "Ano do evento (preenchido automaticamente)"
    },
    "anos_empresa": {
      "type": "number",
      "description": "Quantidade de anos de empresa (apenas para tipo tempo_empresa)"
    },
    "filho_nome": {
      "type": "string",
      "description": "Nome do filho (apenas para tipo aniversario_filho_1ano)"
    },
    "data_envio": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora em que o e-mail foi enviado"
    }
  },
  "required": [
    "tipo_comunicado"
  ]
}