{
  "name": "ReservasSala",
  "type": "object",
  "properties": {
    "solicitante_nome": {
      "type": "string",
      "description": "Nome do solicitante"
    },
    "solicitante_email": {
      "type": "string",
      "description": "Email do solicitante"
    },
    "solicitante_area": {
      "type": "string",
      "description": "\u00c1rea do solicitante"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da reserva"
    },
    "hora_inicio": {
      "type": "string",
      "description": "Hor\u00e1rio de in\u00edcio (HH:mm)"
    },
    "hora_fim": {
      "type": "string",
      "description": "Hor\u00e1rio de fim (HH:mm)"
    },
    "motivo": {
      "type": "string",
      "description": "Motivo / pauta da reserva"
    },
    "num_participantes": {
      "type": "number",
      "description": "N\u00famero estimado de participantes"
    },
    "status": {
      "type": "string",
      "enum": [
        "Confirmada",
        "Cancelada",
        "Conclu\u00edda"
      ],
      "default": "Confirmada",
      "description": "Status da reserva"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "solicitante_nome",
    "data",
    "hora_inicio",
    "hora_fim"
  ]
}