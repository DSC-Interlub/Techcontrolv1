{
  "name": "Comunicados_Config",
  "type": "object",
  "properties": {
    "tipo_comunicado": {
      "type": "string",
      "description": "Tipo do comunicado (chave \u00fanica). Ex: aniversario_colaborador"
    },
    "label": {
      "type": "string",
      "description": "R\u00f3tulo amig\u00e1vel para exibi\u00e7\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Se false, a automa\u00e7\u00e3o n\u00e3o envia mesmo que haja arte"
    },
    "horario_envio": {
      "type": "string",
      "description": "Hor\u00e1rio de disparo no formato HH:MM (ex: 08:00)"
    },
    "assunto_template": {
      "type": "string",
      "description": "Template do assunto com vari\u00e1veis din\u00e2micas. Ex: \ud83c\udf82 Feliz Anivers\u00e1rio, {nome}!"
    },
    "destinatarios_tipo": {
      "type": "string",
      "enum": [
        "todos_colaboradores",
        "colaborador_conjuge_gestor",
        "colaborador_e_gestor",
        "manual"
      ],
      "description": "Como montar a lista de destinat\u00e1rios"
    },
    "destinatarios_adicionais": {
      "type": "array",
      "description": "E-mails fixos que sempre recebem, al\u00e9m dos autom\u00e1ticos",
      "items": {
        "type": "string"
      }
    },
    "cc_emails": {
      "type": "array",
      "description": "E-mails sempre em c\u00f3pia (CC)",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "tipo_comunicado",
    "ativo"
  ]
}