{
  "name": "Canetas_Vibracao",
  "type": "object",
  "properties": {
    "numero_sequencial": {
      "type": "string",
      "description": "N\u00famero sequencial (#)"
    },
    "data_aquisicao": {
      "type": "string",
      "format": "date",
      "description": "Data de aquisi\u00e7\u00e3o do equipamento"
    },
    "tipo": {
      "type": "string",
      "description": "Tipo de caneta"
    },
    "marca": {
      "type": "string",
      "description": "Marca do equipamento"
    },
    "nota_fiscal": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "fornecedor": {
      "type": "string",
      "description": "Fornecedor"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo do equipamento"
    },
    "etiqueta_interna": {
      "type": "string",
      "description": "Etiqueta interna de controle"
    },
    "service_tag": {
      "type": "string",
      "description": "Service Tag ou Serial Number"
    },
    "usuario_atual": {
      "type": "string",
      "description": "Usu\u00e1rio que est\u00e1 usando o equipamento atualmente"
    },
    "usuario_desde": {
      "type": "string",
      "format": "date",
      "description": "Data desde quando o usu\u00e1rio atual possui o equipamento"
    },
    "usuarios_anteriores": {
      "type": "array",
      "description": "Lista de usu\u00e1rios anteriores",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "data_inicio": {
            "type": "string",
            "format": "date"
          },
          "data_fim": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea do usu\u00e1rio"
    },
    "status": {
      "type": "string",
      "enum": [
        "Dispon\u00edvel",
        "Em uso",
        "Manuten\u00e7\u00e3o",
        "Danificado"
      ],
      "default": "Dispon\u00edvel",
      "description": "Status do equipamento"
    },
    "condicao": {
      "type": "string",
      "enum": [
        "R\u00e1pido",
        "Normal",
        "Lento",
        "Com Problema"
      ],
      "description": "Condi\u00e7\u00e3o do equipamento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    }
  },
  "required": []
}