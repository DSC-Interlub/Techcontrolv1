{
  "name": "Colaboradores",
  "type": "object",
  "properties": {
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do colaborador"
    },
    "email": {
      "type": "string",
      "description": "Email corporativo"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea/Departamento"
    },
    "tipo_funcionario": {
      "type": "string",
      "enum": [
        "Interno",
        "Externo"
      ],
      "description": "Tipo de funcion\u00e1rio"
    },
    "telefone": {
      "type": "string",
      "description": "Telefone/Ramal"
    },
    "data_admissao": {
      "type": "string",
      "format": "date",
      "description": "Data de admiss\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "Ativo",
        "F\u00e9rias",
        "Afastado",
        "Desligado"
      ],
      "default": "Ativo",
      "description": "Status do colaborador"
    },
    "cargo": {
      "type": "string",
      "description": "Cargo do colaborador"
    },
    "local_trabalho": {
      "type": "string",
      "description": "Local / Unidade de trabalho"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento do colaborador"
    },
    "graduacao": {
      "type": "string",
      "description": "Gradua\u00e7\u00e3o / Forma\u00e7\u00e3o acad\u00eamica"
    },
    "resumo_experiencia": {
      "type": "string",
      "description": "Resumo de experi\u00eancia profissional"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do colaborador respons\u00e1vel/aprovador (para requisi\u00e7\u00f5es de compra)"
    },
    "responsavel_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel/aprovador"
    },
    "responsavel_email": {
      "type": "string",
      "description": "E-mail do respons\u00e1vel/aprovador"
    },
    "contato_responsavel_nome": {
      "type": "string",
      "description": "Nome do respons\u00e1vel / gestor direto"
    },
    "contato_responsavel_email": {
      "type": "string",
      "description": "E-mail do respons\u00e1vel / gestor direto"
    },
    "conjuge_nome": {
      "type": "string",
      "description": "Nome do c\u00f4njuge"
    },
    "conjuge_email": {
      "type": "string",
      "description": "E-mail do c\u00f4njuge"
    },
    "conjuge_data_nascimento": {
      "type": "string",
      "format": "date",
      "description": "Data de nascimento do c\u00f4njuge"
    },
    "filhos": {
      "type": "array",
      "description": "Lista de filhos do colaborador",
      "items": {
        "type": "object",
        "properties": {
          "filho_nome": {
            "type": "string"
          },
          "filho_data_nascimento": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "incluir_comunicados": {
      "type": "boolean",
      "default": true,
      "description": "Incluir nos comunicados autom\u00e1ticos"
    },
    "permissoes_comunicados": {
      "type": "array",
      "description": "Permiss\u00f5es de acesso ao m\u00f3dulo Comunicados no portal do colaborador",
      "items": {
        "type": "string",
        "enum": [
          "ver_visao_geral",
          "cadastrar_artes",
          "enviar_boas_vindas",
          "enviar_despedida",
          "gerir_colaboradores"
        ]
      }
    },
    "comunicado_boas_vindas_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Controle interno: comunicado de boas-vindas j\u00e1 enviado"
    },
    "comunicado_despedida_enviado": {
      "type": "boolean",
      "default": false,
      "description": "Controle interno: comunicado de despedida j\u00e1 enviado"
    },
    "comunicados_historico": {
      "type": "array",
      "description": "Hist\u00f3rico de comunicados enviados",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "data_envio": {
            "type": "string"
          },
          "ano": {
            "type": "number"
          },
          "destinatarios": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assunto": {
            "type": "string"
          }
        }
      }
    },
    "senha_portal": {
      "type": "string",
      "description": "Senha de acesso ao portal do colaborador"
    },
    "senha_precisa_trocar": {
      "type": "boolean",
      "default": false,
      "description": "Se true, o colaborador deve definir nova senha no pr\u00f3ximo acesso"
    },
    "acesso_portal_bloqueado": {
      "type": "boolean",
      "default": false,
      "description": "Se true, o colaborador n\u00e3o pode acessar o portal"
    },
    "senha_microsoft": {
      "type": "string",
      "description": "Senha da conta Microsoft/Office 365"
    },
    "senha_login_maquina": {
      "type": "string",
      "description": "Senha para login no computador/notebook"
    },
    "senhas_sistemas": {
      "type": "array",
      "description": "Senhas de sistemas corporativos",
      "items": {
        "type": "object",
        "properties": {
          "sistema": {
            "type": "string"
          },
          "usuario": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          },
          "observacoes": {
            "type": "string"
          }
        }
      }
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto do colaborador"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    }
  },
  "required": [
    "nome_completo",
    "area"
  ]
}